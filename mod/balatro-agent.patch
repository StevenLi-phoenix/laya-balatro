diff --git a/mod/src/game_events.lua b/mod/src/game_events.lua
index 1999ada..32b877e 100644
--- a/mod/src/game_events.lua
+++ b/mod/src/game_events.lua
@@ -16,6 +16,15 @@ function GameEvents.mark_work()
   return mark
 end
 
+-- juice_card_until (DNA and Trading Card from blind select, Loyalty Card when
+-- active, a ready Invisible Joker) re-queues a fresh REAL-timer, non-blocking,
+-- non-blockable event every 0.8 s until its condition ends, so it is always
+-- newer than any mark. Game logic runs on the TOTAL timer (pack cards from
+-- Card:open included); REAL-timer background events are presentation only.
+local function is_presentation(event)
+  return event.timer == 'REAL' and event.blocking == false and event.blockable == false
+end
+
 -- Settled when no queued event is both newer than the mark and transient.
 -- Persistent (no_delete) events survive queue resets by design and do not
 -- block action completion.
@@ -25,7 +34,7 @@ function GameEvents.work_settled(mark)
   for _, queue in pairs(manager.queues) do
     for i = 1, #queue do
       local event = queue[i]
-      if not event.no_delete and not mark.events[event] then return false end
+      if not event.no_delete and not mark.events[event] and not is_presentation(event) then return false end
     end
   end
   return true

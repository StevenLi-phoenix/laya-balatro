 -- Settle builders: async actions return these so the dispatcher holds the
 -- response until the game can act on the result.
+-- What still holds the event queues open when a settle times out (logged and
+-- returned so a wait that always runs to its timeout can be traced).
+local function pending_events()
+  local out = {}
+  local manager = G and G.E_MANAGER
+  if not manager or not manager.queues then return out end
+  for name, queue in pairs(manager.queues) do
+    for i = 1, #queue do
+      local e = queue[i]
+      if not e.no_delete and #out < 8 then
+        out[#out + 1] = string.format("%s#%d trigger=%s blocking=%s blockable=%s delay=%s timer=%s",
+          name, i, tostring(e.trigger), tostring(e.blocking), tostring(e.blockable), tostring(e.delay),
+          tostring(e.timer))
+      end
+    end
+  end
+  return out
+end
+
 local function settle_result(data, timed_out)
   data = data or {}
   data.timed_out = timed_out or nil
+  if timed_out then
+    data.pending = pending_events()
+    print("[balatro-agent] settle timed out; pending: " .. table.concat(data.pending, " | "))
+  end
   return { ok = true, data = data }
 end
 
